{
  "expo": {
    "name": "Shinitz Rider",
    "slug": "shinitz-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shinitzrider",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.shinitz.rider",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/images/adaptive-icon.png", "backgroundColor": "#0c0c0c" },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      "expo-image-picker",
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Allow Shinitz Rider to access your location" }],
      ["expo-splash-screen", { "image": "./assets/images/icon.png", "imageWidth": 180, "resizeMode": "contain", "backgroundColor": "#DCE7B3" }],
      ["expo-notifications", { "icon": "./assets/images/notification-icon.png", "color": "#0E8A4F" }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "eas": { "projectId": "REPLACE_WITH_PER_APP_EAS_PROJECT_ID" } },
    "owner": "shinitz",
    "_notes": "Per-app TODO: run 'eas init' to get a unique projectId; add a google-services.json matching com.shinitz.rider if using Firebase messaging; swap in app-specific icon/splash/notification-icon."
  }
}
